# Cloudflare Account
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# R2 Storage (S3-compatible credentials)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=market-data-lakehouse
R2_ENDPOINT_URL=https://{CF_ACCOUNT_ID}.r2.cloudflarestorage.com

# R2 Data Catalog (Iceberg)
R2_CATALOG_NAME=market-data-catalog
R2_CATALOG_ENDPOINT=https://api.cloudflare.com/client/v4/accounts/{CF_ACCOUNT_ID}/r2/buckets/{R2_BUCKET_NAME}/catalog

# Alpaca Markets (free tier for options)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://data.alpaca.markets

# Alpha Vantage (optional, $50/mo upgrade)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Risk-free rate for B-S greeks calculation
RISK_FREE_RATE=0.05
